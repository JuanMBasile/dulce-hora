---
import { Picture } from "astro:assets";
import medialunas from "~/assets/photos/medialunas-manteca.jpg";
import { sections } from "~/data/site";
import { story } from "~/data/story";
import { festoonPolygon } from "~/lib/festoon";
import styles from "./Story.module.css";

// El mismo polígono sirve para el borde rojo y para la ventana: cada uno define su `--r`.
const festoonStyle = `--festoon: ${festoonPolygon()}`;

// Quieta (sin JS o con movimiento reducido) la foto es un sello de 30rem; en la escena, la pantalla entera.
const photoSizes = "(scripting: none) min(90vw, 30rem), (prefers-reduced-motion: reduce) min(90vw, 30rem), 100vw";

const words = story.manifesto.split(" ");
const accents = new Set<string>(story.manifestoAccents);
const bare = (word: string) => word.replace(/[.,;:]/g, "");
const [closingBefore, closingAfter] = story.closing.split(" hora ");
---

<!--
  "Nuestra historia": la escena queda fija mientras se scrollea. El festón del sello gira como
  un reloj y se abre hasta mostrar la foto entera; el título se corre como un telón y el
  manifiesto se enciende palabra por palabra (la frase grande de la skill landing-page-design,
  B11). GSAP calcula el scroll y escribe cuatro variables; el CSS decide qué mueve cada una.
  Sin JavaScript o con movimiento reducido, la misma composición queda quieta y completa.
-->
<section id={sections.historia} tabindex="-1" class={styles.section} aria-labelledby="historia-titulo">
  <div class={styles.scene} data-story-scene>
    <div class={styles.stage} data-story-stage style="--open: 0; --veil: 0; --read: 0; --turn: -150deg">
      <h2 id="historia-titulo" class={styles.title}>
        <span class={styles.titleWord} data-side="start">Nuestra</span>{" "}
        <span class:list={[styles.titleWord, styles.accent]} data-side="end">historia</span>
      </h2>

      <div class={styles.art}>
        <div class={styles.rim} style={festoonStyle}></div>
        <div class={styles.window} style={festoonStyle}>
          <div class={styles.photo}>
            <Picture
              src={medialunas}
              alt="Medialunas de manteca doradas y brillantes, acomodadas en una bandeja."
              formats={["avif", "webp"]}
              widths={[640, 960, 1280, 1616]}
              sizes={photoSizes}
              pictureAttributes={{ class: styles.picture }}
              class={styles.img}
            />
            <div class={styles.veil}></div>
          </div>
        </div>
      </div>

      <div class={styles.reading}>
        <p class={styles.manifesto} style={`--n: ${words.length}`}>
          {
            words.map((word, index) => (
              <>
                <span class={styles.word} data-accent={accents.has(bare(word)) || undefined} style={`--i: ${index}`}>
                  {word}
                </span>{" "}
              </>
            ))
          }
        </p>
      </div>
    </div>
  </div>

  <div class:list={["festoon-top", styles.body]}>
    <div class:list={["page-width", styles.bodyInner]}>
      <div class={styles.origin} data-reveal>
        <h3 class={styles.originTitle}>{story.originTitle}</h3>
        <p class={styles.originText}>{story.origin}</p>
      </div>

      <div class={styles.values}>
        <h3 class={styles.valuesTitle} data-reveal>{story.valuesTitle}</h3>
        <ul role="list" class={styles.valueList}>
          {
            story.values.map((value) => (
              <li class={styles.value}>
                <h4 class={styles.valueName}>
                  <span class={styles.valueNameInner}>{value.name}</span>
                </h4>
                <p class={styles.valueText}>{value.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <p class={styles.closing} data-reveal>
        {closingBefore} <span class={styles.accent}>hora</span> {closingAfter}
      </p>
    </div>
  </div>
</section>

<script>
  import { initStory } from "./story";

  initStory();
</script>
